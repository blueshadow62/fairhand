{
  "name": "geulnun",
  "productName": "글눈",
  "version": "0.2.7",
  "description": "손글씨 서·논술형 답안지 전사·채점 도구",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.preload.json && node scripts/rename-preload.mjs",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "score": "tsc && node dist/scripts/score-set.js",
    "transcribe": "tsc && node dist/scripts/transcribe-set.js",
    "eval": "tsc && node dist/scripts/eval.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.5.438"
  },
  "build": {
    "appId": "kr.geulnun.app",
    "productName": "글눈",
    "executableName": "Geulnun",
    "copyright": "Copyright © 2026 blueshadow62. Apache-2.0.",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/src/**",
      "dist-preload/**",
      "src/renderer/**",
      "resources/**",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!**/*.map",
      "!dist/tests/**",
      "!dist/scripts/**",
      "!local/**",
      "!tests/**",
      "!docs/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!src/renderer/**/*.ts"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "geulnun-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "createDesktopShortcut": true,
      "shortcutName": "글눈"
    },
    "publish": {
      "provider": "github",
      "owner": "blueshadow62",
      "repo": "fairhand",
      "releaseType": "draft"
    }
  }
}
